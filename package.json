{
  "name": "chess-opening-trainer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pawnado (your road to 1500): interactive chess gambit and opening trainer for casual players, with Stockfish grading",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2020 --outfile=dist/app.js",
    "test:book": "node tools/check-book.mjs",
    "serve": "python3 -m http.server 8080",
    "test:e2e": "node tools/e2e.mjs && node tools/e2e-extra.mjs",
    "test:gambits": "node tools/e2e-gambits.mjs",
    "test:touch": "node tools/e2e-touch.mjs",
    "audit": "node tools/audit-book.mjs",
    "test:lore": "node tools/check-lore.mjs",
    "test:learn": "node tools/e2e-learn.mjs",
    "test:ratings": "node tools/e2e-ratings.mjs",
    "test:style": "node tools/e2e-style.mjs",
    "test:brand": "node tools/e2e-brand.mjs",
    "test:themes": "node tools/e2e-themes.mjs",
    "test:lines": "node tools/test-lines.mjs",
    "test:daily-e2e": "node tools/e2e-daily.mjs",
    "test:daily": "node tools/test-daily.mjs",
    "test:progress-unit": "node tools/test-progress.mjs",
    "test:progress": "node tools/e2e-progress.mjs",
    "gen:ease": "node tools/gen-ease.mjs",
    "test:haptics": "node tools/e2e-haptics.mjs",
    "test:hint": "node tools/e2e-hint.mjs",
    "build:tactics": "node tools/build-tactics.mjs",
    "test:tactics-unit": "node tools/test-tactics.mjs",
    "test:tactics": "node tools/e2e-tactics.mjs",
    "test:tactics-dock": "node tools/e2e-tactics-dock.mjs",
    "test:tip": "node tools/e2e-tip.mjs",
    "test:tip-pill": "node tools/e2e-tip-pill.mjs",
    "test:default-pieces": "node tools/e2e-default-pieces.mjs",
    "test:stepper": "node tools/e2e-stepper.mjs",
    "test:nav": "node tools/e2e-nav.mjs",
    "test:licenses": "node tools/check-licenses.mjs",
    "test:about": "node tools/e2e-about.mjs",
    "test:feedback": "node tools/e2e-feedback.mjs",
    "test:coords": "node tools/e2e-coords.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1"
  },
  "devDependencies": {
    "esbuild": "*",
    "stockfish": "^19.0.1",
    "playwright-core": "*"
  },
  "homepage": "https://goose285.github.io/chess-opening-trainer/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Goose285/chess-opening-trainer.git"
  },
  "bugs": {
    "url": "https://github.com/Goose285/chess-opening-trainer/issues"
  },
  "license": "GPL-3.0-or-later",
  "author": "Seth Moynahan"
}
